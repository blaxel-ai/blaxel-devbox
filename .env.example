# Copy to .env and fill in, then: set -a; source .env; set +a

# Blaxel auth. BL_WORKSPACE is required; BL_API_KEY is read by the SDK, or you
# can `bl login` instead of setting it here.
BL_WORKSPACE=your-workspace
BL_API_KEY=

# Claude Code auth, injected into the box at runtime only (never baked in).
# Required for `python launch.py`; not required for `python launch.py --no-agent`.
ANTHROPIC_API_KEY=

# Devbox image id from `bl deploy` in ./devbox. Set after the first deploy:
#   until DEVBOX_IMAGE=$(bl get sandbox blaxel-devbox -ojson | jq -r '.[0].spec.runtime.image // empty') && [ -n "$DEVBOX_IMAGE" ]; do sleep 5; done
#   export DEVBOX_IMAGE
DEVBOX_IMAGE=blaxel-devbox:latest

# Name for the launched sandbox.
DEVBOX_NAME=blaxel-devbox-demo

# Optional: 1Password service-account token for adapted tasks. The `op` CLI is
# baked into the image, but this token must still be passed into the sandbox at
# runtime with `run(..., env=...)` or `run_agent(..., extra_env=...)`; do not bake
# it into the image or commit it here. The stock demo target's login is generated
# per-run and injected at runtime, so you don't need this to try the demo.
# OP_SERVICE_ACCOUNT_TOKEN=
